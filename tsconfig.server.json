{
  // server/ y api/: Vercel los compila archivo por archivo y Node, en ESM, no completa
  // extensiones, así que los imports relativos llevan .js y la resolución es nodenext.

  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,

    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["server", "api"]
}
