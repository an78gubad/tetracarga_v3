# Credencial y punto de acceso del proveedor del modelo.
#
# Ninguna de estas variables lleva prefijo VITE_: Vite mete las que lo llevan en el bundle
# del navegador, y ni la clave ni la URL del proveedor pueden llegar ahí (FR-015, AC-19).
# Viven solo del lado del servidor, donde las lee server/modelo/deepseek.ts.

# Clave de la API de DeepSeek. Obligatoria para `npm run dev` y `npm run eval`.
DEEPSEEK_API_KEY=

# URL base del proveedor. Obligatoria.
DEEPSEEK_BASE_URL=

# Modelo a usar. Opcional: si no está, se usa deepseek-flash.
DEEPSEEK_MODELO=
